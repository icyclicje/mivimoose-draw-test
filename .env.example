# ---------------------------------------------------------------------------
# Copy to .env and fill in. One file feeds both workspaces.
#
# EVERY VARIABLE HERE IS OPTIONAL. The server boots with none of them set, which
# is what makes `railway up` on a bare project work: guest accounts, every mode,
# the daily, friends and the leaderboard all run without configuration.
#
# What you give up by leaving each one blank is noted against it, and the server
# says the same thing in its boot log.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Discord application  (https://discord.com/developers/applications)
#
# OPTIONAL, both or neither. Without them Discord sign-in is off and everyone
# plays as a guest — the game is otherwise identical. Add them later and it
# starts working on the next boot; the front end reads the client id from the
# server, so you do not need to rebuild it.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me
# Optional, unused by the game itself.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# OPTIONAL, 16+ characters. Signs the session JWT handed to the client.
#
# Left blank, the server generates one and saves it to
# $RAILWAY_VOLUME_MOUNT_PATH/.session-secret (or server/data/.session-secret),
# so sessions survive a restart. Set it explicitly if you want them to survive a
# redeploy onto a fresh filesystem, or if you run more than one instance —
# separate instances would otherwise each invent their own and reject each
# other's tokens.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma separated. The Discord Activity origin is allowed automatically.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database  (SQLite by default; swap for a postgresql:// URL in production and
# change the provider in server/prisma/schema.prisma to match)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./arena.db"

# ---------------------------------------------------------------------------
# Semantic engine
#
# Run `npm run setup:words` once to download GloVe plus the dictionaries and
# build data/index.bin — 200,000 guessable words and ~18,000 answers.
#
#   auto     use data/index.bin when present, else the bundled topic model
#   vectors  require the index, fail loudly if it is missing
#   topic    always use the small bundled model (no download, 1,808 words)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto
VECTOR_INDEX_PATH=./data/index.bin
# How deep the rank table goes. Matches the index size by default.
RANK_DEPTH=200000

# ---------------------------------------------------------------------------
# Client (Vite)
# ---------------------------------------------------------------------------
VITE_DISCORD_CLIENT_ID=000000000000000000
VITE_SERVER_URL=http://localhost:3001
