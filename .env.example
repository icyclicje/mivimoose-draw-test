# ---------------------------------------------------------------------------
# Copy to .env and fill in. One file feeds both workspaces.
#
# Discord credentials are only needed to run as a Discord Activity. Guest play
# works without them, so you can clone, `npm run setup:words`, and play.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Discord application  (https://discord.com/developers/applications)
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me
# Optional, unused by the game itself.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# 16+ characters. Signs the session JWT handed to the client.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma separated. The Discord Activity origin is allowed automatically.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database  (SQLite by default; swap for a postgresql:// URL in production and
# change the provider in server/prisma/schema.prisma to match)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./arena.db"

# ---------------------------------------------------------------------------
# Semantic engine
#
# Run `npm run setup:words` once to download GloVe plus the dictionaries and
# build data/index.bin — 200,000 guessable words and ~18,000 answers.
#
#   auto     use data/index.bin when present, else the bundled topic model
#   vectors  require the index, fail loudly if it is missing
#   topic    always use the small bundled model (no download, 1,808 words)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=auto
VECTOR_INDEX_PATH=./data/index.bin
# How deep the rank table goes. Matches the index size by default.
RANK_DEPTH=200000

# ---------------------------------------------------------------------------
# Client (Vite)
# ---------------------------------------------------------------------------
VITE_DISCORD_CLIENT_ID=000000000000000000
VITE_SERVER_URL=http://localhost:3001
